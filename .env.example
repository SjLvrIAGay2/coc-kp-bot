# 默认离线模式；密钥只在进程环境中读取，绝不要提交实际密钥。
DEEPSEEK_API_KEY=
# HTTP serve 的模型选择；terminal 真实模式仍需命令行 --real。
COCKP_LLM=fake
COCKP_DATABASE=data/cockp.sqlite3
COCKP_ADMIN_IDS=10001
COCKP_GROUP_IDS=20001
# HTTP 管理 API 使用独立口令；生产中务必设置。
COCKP_API_TOKEN=
ONEBOT_SECRET=
ONEBOT_SELF_ID=
COCKP_BOT_IDS=
ONEBOT_ACCESS_TOKEN=
ONEBOT_API_URL=http://127.0.0.1:3000
COCKP_IMAGES_ENABLED=false
# 程序配置图独立于模型生图。默认查找微软雅黑/Noto CJK，可指定本机中文字体文件。
# COCKP_CONFIG_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 生图完整 HTTPS POST 端点（例如 https://your-service.example/generate）。
IMAGE_API_URL=
IMAGE_API_TOKEN=
COCKP_RULEBOOK_INDEX=data/private/rulebook
# Optional approved public-file library (original PDFs stay outside code/images).
# Defaults to the database directory's shared-files folder, or the current directory without COCKP_DATABASE.
COCKP_SHARED_FILES_ROOT=
COCKP_CONTEXT_TOKEN_BUDGET=131072
# 主KP注意力工作集上限（UTF-8字节/2估算，非精确分词）。与上一项取较小值。
# 默认128k资料工作集；常规主KP入口使用1M请求窗口，输出协议与模型窗口另外校验。
COCKP_WORKING_CONTEXT_TOKEN_BUDGET=131072
# 任一实际上下文预算达到80%时，发送前先本地压缩旧历史，尽量降到60%。
# 当前请求、权威状态、承诺、待办及最新4条对话完整保留；不新增模型调用。
COCKP_CONTEXT_AUTO_COMPACT=true
COCKP_CONTEXT_COMPACT_TRIGGER_PERCENT=80
COCKP_CONTEXT_COMPACT_TARGET_PERCENT=60
# 自动资料的私密存储根目录；默认是数据库父目录/private/documents。
# COCKP_DOCUMENT_ROOT=data/private/documents

# 辅助通道 router/module/character/memory；fake 模式均零网络。
# 优先级：角色覆盖 > 以下全局辅助配置 > 程序默认。
# API_KEY 未设置时回退 DEEPSEEK_API_KEY，切勿写空的辅助 API_KEY= 遮蔽回退。
# COCKP_AUX_API_KEY=
COCKP_AUX_BASE_URL=https://api.deepseek.com
COCKP_AUX_MODEL=deepseek-flash
COCKP_AUX_MAX_ATTEMPTS=2
COCKP_AUX_MAX_CALLS_PER_JOB=3
COCKP_AUX_MAX_TOTAL_REQUESTS=1000
COCKP_AUX_MAX_CONTEXT_CHARS=24000
# 未设置时单次HTTP超时：module180秒 / 其余30秒；启用全局值会覆盖角色默认。
# COCKP_AUX_TIMEOUT=30
COCKP_AUX_BACKOFF=0.25
# 未设置时输出预算：router700 / module32768 / character4096 / memory2048。
# 模组默认上下文预算1048576 token，输出额度含推理；按实际用量计费，不预先耗满额度。
# 未设置时并发：router2 / 其余各1；以下全局覆盖会覆盖这些分角色默认。
# COCKP_AUX_MAX_OUTPUT_TOKENS=4096
# COCKP_AUX_CONCURRENCY=1

# 每个角色可覆盖上述所有字段；只取消所需行的注释。
# COCKP_AUX_ROUTER_API_KEY=
# COCKP_AUX_ROUTER_BASE_URL=https://api.deepseek.com
# COCKP_AUX_ROUTER_MODEL=deepseek-flash
# COCKP_AUX_ROUTER_MAX_OUTPUT_TOKENS=700
# COCKP_AUX_ROUTER_CONCURRENCY=2
# COCKP_AUX_MODULE_API_KEY=
# COCKP_AUX_MODULE_BASE_URL=https://api.deepseek.com
# COCKP_AUX_MODULE_MODEL=deepseek-flash
# COCKP_AUX_MODULE_MAX_OUTPUT_TOKENS=32768
# COCKP_AUX_CHARACTER_API_KEY=
# COCKP_AUX_CHARACTER_BASE_URL=https://api.deepseek.com
# COCKP_AUX_CHARACTER_MODEL=deepseek-flash
# COCKP_AUX_CHARACTER_MAX_OUTPUT_TOKENS=4096
# COCKP_AUX_MEMORY_API_KEY=
# COCKP_AUX_MEMORY_BASE_URL=https://api.deepseek.com
# COCKP_AUX_MEMORY_MODEL=deepseek-flash
# COCKP_AUX_MEMORY_MAX_OUTPUT_TOKENS=2048

# 官方 QQ Webhook。首次接入时填写自己的应用、群、群主及接入口令摘要。
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_EXPECTED_LEGACY_GROUP=
QQBOT_EXPECTED_LEGACY_OWNER=
QQBOT_ENROLLMENT_CODE_HASH=

# 可选群名片桥。QQ_PERSONAL_SELF_ID 对应名片桥本地配置里的 ONEBOT_SELF_ID。
QQ_PERSONAL_SELF_ID=
QQ_PERSONAL_BRIDGE_URL=
QQ_PERSONAL_BRIDGE_TOKEN=
